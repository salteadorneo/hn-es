---
import { withBase } from '../lib/url';

const items = [
  { href: withBase(), label: 'Portada' },
  { href: withBase('show'), label: 'Ideas' },
  { href: withBase('build-board'), label: 'Build Board' },
  { href: withBase('products-database'), label: 'Database' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<nav aria-label="Secciones" class="mx-auto flex max-w-full items-center justify-center gap-1 overflow-x-auto pb-4 font-mono text-[10px] uppercase tracking-[0.22em]">
  {items.map((item) => {
    const path = item.href.replace(/\/+$/, '') || '/';
    const active = current === path;
    return (
      <a
        href={item.href}
        aria-current={active ? 'page' : undefined}
        class:list={[
          'whitespace-nowrap rounded-full px-4 py-1.5 transition-all duration-200',
          active
            ? 'bg-accent text-paper shadow-[0_0_0_1px_color-mix(in_oklab,var(--color-accent)_40%,transparent)]'
            : 'text-muted hover:bg-surface hover:text-ink',
        ]}
      >
        {item.label}
      </a>
    );
  })}
</nav>
