---
import SiteNav from './SiteNav.astro';
import { withBase } from '../lib/url';

const brands = [
  { href: withBase(), name: 'Hacker News' },
  { href: withBase('show'), name: 'Ideas' },
  { href: withBase('build-board'), name: 'Indie Hackers' },
  { href: withBase('products-database'), name: 'Indie Hackers' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const brand = brands.find((item) => (item.href.replace(/\/+$/, '') || '/') === current)?.name ?? 'Hacker News';

const lastUpdated = new Date().toLocaleString('es-ES', { timeZone: 'Europe/Madrid', dateStyle: 'full', timeStyle: 'short' });
---

<header class="site-header sticky top-0 z-30 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-4">
    <div class="header-strip flex items-center justify-center gap-3 border-b border-rule/70 py-2 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
      <span class="inline-flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 bg-accent" aria-hidden="true"></span>
        Actualizado {lastUpdated}
      </span>
    </div>
    <div class="header-main flex items-center justify-center gap-3 py-5">
      <span class="brand-mark" aria-hidden="true">HN</span>
      <h1 class="nameplate text-balance text-ink">
        {brand} <span class="font-light italic text-accent-soft">en Español</span>
      </h1>
    </div>
    <SiteNav />
  </div>
</header>

<script>
  const headerEl = document.querySelector('.site-header') as HTMLElement | null;
  let isCompact = false;
  function updateHeader() {
    if (!headerEl) return;
    const y = window.scrollY;
    // Histéresis: umbrales distintos para activar/desactivar evitan el parpadeo
    // cuando el cambio de altura del header altera la posición de scroll.
    if (!isCompact && y > 96) {
      isCompact = true;
      headerEl.classList.add('is-compact');
    } else if (isCompact && y < 40) {
      isCompact = false;
      headerEl.classList.remove('is-compact');
    }
  }
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateHeader();
      ticking = false;
    });
  }, { passive: true });
  updateHeader();
</script>
