---
import Layout from '../layouts/Layout.astro';
import { fetchFeedIds, fetchItem, domainOf, timeAgo, hnLink, fetchContext, fetchPageImages } from '../scripts/hn';
import type { ContextImage } from '../scripts/hn';
import { toSpanish, mapLimit, OPENROUTER_ENABLED } from '../scripts/translate';

type StoryImage = ContextImage;
type Story = {
  id: number;
  title: string;
  titleEs: string;
  url?: string;
  score?: number;
  by?: string;
  time?: number;
  descendants?: number;
  text?: string;
  textSnippet?: string;
  images?: StoryImage[];
};

const PAGE_SIZE = 20;
const TOTAL_FETCH = PAGE_SIZE;
const SNIPPET_LIMIT = OPENROUTER_ENABLED ? 1800 : 450;

function isLargeImage(img: StoryImage): boolean {
  return (img.width >= 500 || img.height >= 350 || img.width * img.height >= 150000);
}

function titleSize(score: number): string {
  const s = score ?? 0;
  if (s >= 500) return 'text-4xl';
  if (s >= 400) return 'text-4xl';
  if (s >= 300) return 'text-3xl';
  if (s >= 200) return 'text-2xl';
  if (s >= 150) return 'text-xl';
  if (s >= 50) return 'text-lg';
  return 'text-base';
}

function stripHtml(html: string): string {
  let h = html.replace(/<a\b[^>]*?\shref=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi, (_m, url, text) => {
    const t = String(text).replace(/<[^>]*>/g, '').trim();
    return `[${t}](${url})`;
  });
  const tmp = (globalThis as any).document ? document.createElement('textarea') : null;
  if (tmp) {
    tmp.innerHTML = h.replace(/<[^>]*>/g, ' ');
    return (tmp.value || '').replace(/\s+/g, ' ').trim();
  }
  const decoded = h
    .replace(/<[^>]*>/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCharCode(parseInt(n, 16)));
  return decoded.replace(/\s+/g, ' ').trim();
}

function mdToHtml(md: string): string {
  if (!md) return '';
  let s = md
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  s = s.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
  const links: { text: string; url: string }[] = [];
  s = s.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, (_m, text, url) => {
    const idx = links.length;
    links.push({ text, url });
    return `\u0000LINK${idx}\u0000`;
  });
  s = s.replace(/https?:\/\/\S+/g, '');
  s = s.replace(/\u0000LINK(\d+)\u0000/g, (_m, i) => {
    const { text, url } = links[Number(i)];
    return `<a href="${url}" target="_blank" rel="noopener" class="text-stone-700 hover:underline">${text}</a>`;
  });
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  s = s.replace(/^### (.+)$/gm, '<h4 class="mt-2 font-serif font-bold text-stone-900">$1</h4>');
  s = s.replace(/^## (.+)$/gm, '<h3 class="mt-2 font-serif font-bold text-stone-900">$1</h3>');
  s = s.replace(/^# (.+)$/gm, '<h2 class="mt-2 font-serif font-bold text-stone-900">$1</h2>');
  const lines = s.split(/\n/);
  const out: string[] = [];
  let inList = false;
  for (const line of lines) {
    const m = line.match(/^\s*[-*]\s+(.+)/);
    if (m) {
      if (!inList) { out.push('<ul class="ml-5 list-disc space-y-1">'); inList = true; }
      out.push(`<li>${m[1]}</li>`);
    } else {
      if (inList) { out.push('</ul>'); inList = false; }
      if (line.trim() === '') out.push('</p><p class="mt-2">');
      else if (line.trim().startsWith('<h') || line.trim().startsWith('<ul') || line.trim().startsWith('</ul>')) out.push(line);
      else out.push(line + '<br>');
    }
  }
  if (inList) out.push('</ul>');
  s = out.join('\n');
  if (!/^<[hupul]/.test(s.trim())) s = `<p>${s}</p>`;
  s = s.replace(/<p>\s*<\/p>/g, '');
  return s;
}

let allIds: number[] = [];
let loadedStories: Story[] = [];

try {
  const [topIds, bestIds] = await Promise.all([
    fetchFeedIds('top', 40),
    fetchFeedIds('best', 40),
  ]);
  allIds = [...new Set([...topIds, ...bestIds])].slice(0, TOTAL_FETCH);

  const items = await Promise.all(allIds.map((id) => fetchItem(id)));
  const stories: Story[] = items
    .filter((it): it is NonNullable<typeof it> => !!it && !it.deleted && !it.dead)
    .map((it) => {
      const rawTitle = it.title || '(sin título)';
      const title = rawTitle.replace(/^Show HN:\s*/i, '').trim();
      return {
        id: it.id,
        title,
        titleEs: title,
        url: it.url,
        score: it.score,
        by: it.by,
        time: it.time,
        descendants: it.descendants,
        text: it.text,
      };
    });

  loadedStories = await mapLimit(stories, 4, async (s, i) => {
    const __t0 = Date.now();
    console.log('[HN][story] start', i, s.id, s.url || '(no url)');
    const titleEs = await toSpanish(s.title);
    let snippet = s.text ? stripHtml(s.text) : '';
    if (snippet.length > SNIPPET_LIMIT) snippet = snippet.slice(0, SNIPPET_LIMIT - 1) + '…';
    let images: StoryImage[] = [];
    if (s.url && i < 10) {
      const ctx = await fetchContext(s.url);
      if (!snippet) snippet = ctx.text;
      if (snippet.length > SNIPPET_LIMIT) snippet = snippet.slice(0, SNIPPET_LIMIT - 1) + '…';
      images = ctx.images || [];
    } else if (s.url && i < 15) {
      images = await fetchPageImages(s.url);
    }
    if (snippet) {
      snippet = await toSpanish(snippet);
    }
    console.log('[HN][story] done', i, s.id, 'images=', images.length, 'snippet=', snippet.length, 'ms=', Date.now() - __t0);
    return { ...s, titleEs, textSnippet: snippet, images };
  });
} catch (err) {
  console.error(err);
  loadedStories = [];
}

const hero = loadedStories[0];
const rest = loadedStories.slice(1);
const lastUpdated = new Date().toLocaleString('es-ES', { dateStyle: 'full', timeStyle: 'short' });
const today = new Date().toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Hacker News en Español">
  <header class="sticky top-0 z-10 border-b-2 border-stone-400 bg-stone-50/90 backdrop-blur">
    <div class="mx-auto max-w-6xl px-4 py-3 transition-all duration-200">
      <div class="flex items-center justify-between gap-3">
        <div class="text-xs uppercase tracking-widest text-stone-500">{today}</div>
        <div class="text-xs text-stone-600">Última actualización: {lastUpdated}</div>
      </div>
      <div class="mt-2 border-t border-stone-300 pt-2 text-center">
        <h1 class="font-serif text-4xl font-black tracking-tight text-stone-900 sm:text-5xl transition-all duration-200">Hacker News en Español</h1>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 py-6">
    {loadedStories.length === 0 && (
      <div class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-700">
        No se pudo conectar con Hacker News.
      </div>
    )}

    {hero && (
      <section class="mb-6">
        <article class="overflow-hidden border-b-2 border-stone-900 pb-6">
          {hero.images && hero.images.length > 0 && isLargeImage(hero.images[0]) && (
            <img src={hero.images[0].src} alt="" class="mb-4 h-80 w-full rounded object-cover" loading="lazy" />
          )}
          {hero.images && hero.images.length > 0 && !isLargeImage(hero.images[0]) && (
            <img src={hero.images[0].src} alt="" class="mb-4 h-24 w-24 rounded object-cover float-right ml-4" loading="lazy" />
          )}
          {hero.images && hero.images.length > 1 && (
            <div class="mb-4 flex flex-wrap gap-2">
              {hero.images.slice(1).map((img) => (
                <img src={img.src} alt="" class="h-20 w-20 rounded object-cover" loading="lazy" />
              ))}
            </div>
          )}
          <div class="flex items-start gap-3">
            <a href={hero.url || hnLink(hero.id)} target="_blank" rel="noopener" class="text-3xl font-bold leading-tight text-stone-900 hover:text-orange-700 hn-title">
              {hero.titleEs || hero.title}
            </a>
          </div>
          {hero.textSnippet && (
            <div class="mt-3 text-base text-stone-700 line-clamp-8" set:html={mdToHtml(hero.textSnippet)} />
          )}
          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-stone-600">
            <span>por {hero.by || 'anonimo'}</span>
            <span>·</span>
            <span>{timeAgo(hero.time)}</span>
            <span>·</span>
            <a href={hnLink(hero.id)} target="_blank" rel="noopener" class="text-stone-700 hover:underline">{(hero.descendants ?? 0).toLocaleString('es-ES')} comentarios</a>
            <span>·</span>
            <span class="text-stone-500">{domainOf(hero.url)}</span>
          </div>
        </article>
      </section>
    )}

    {rest.length > 0 && (
      <section>
        <h2 class="mb-3 text-lg font-semibold text-stone-900">Últimas noticias</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((s) => {
            const isGithub = /github\.com/i.test(s.url || '');
            const span = (s.score ?? 0) >= 500 ? 'sm:col-span-2' : '';
            return (
              <article class={`group border-b border-stone-300 py-6 ${span}`}>
                {s.images && s.images.length > 0 && isLargeImage(s.images[0]) && (
                  <img src={s.images[0].src} alt="" class="mb-3 h-44 w-full rounded object-cover" loading="lazy" />
                )}
                {s.images && s.images.length > 0 && !isLargeImage(s.images[0]) && (
                  <img src={s.images[0].src} alt="" class="mb-3 h-20 w-20 rounded object-cover float-right ml-3" loading="lazy" />
                )}
                {s.images && s.images.length > 1 && (
                  <div class="mb-2 flex flex-wrap gap-1">
                    {s.images.slice(1, 4).map((img) => (
                      <img src={img.src} alt="" class="h-12 w-12 rounded object-cover" loading="lazy" />
                    ))}
                  </div>
                )}
                <div class="flex items-start gap-2">
                  {isGithub && (
                    <svg class="inline-block h-5 w-5 shrink-0 text-stone-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" />
                    </svg>
                  )}
                  <a href={s.url || hnLink(s.id)} target="_blank" rel="noopener" class={`block ${titleSize(s.score ?? 0)} font-serif font-bold leading-tight text-stone-900 hover:text-orange-700 hn-title`}>
                    {s.titleEs || s.title}
                  </a>
                </div>
                <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-stone-600">
                  <span>por {s.by || 'anónimo'}</span>
                  <span>·</span>
                  <span>{timeAgo(s.time)}</span>
                  <span>·</span>
                  <a href={hnLink(s.id)} target="_blank" rel="noopener" class="text-stone-700 hover:underline">{(s.descendants ?? 0).toLocaleString('es-ES')} comentarios</a>
                </div>
                {s.textSnippet && (
                  <div class="mt-2 text-sm text-stone-700 line-clamp-8" set:html={mdToHtml(s.textSnippet)} />
                )}
              </article>
            );
          })}
        </div>
      </section>
    )}

    <footer class="mt-10 border-t border-stone-300 pt-4 text-center text-xs text-stone-500">
      Datos de <a class="text-stone-700 hover:underline" href="https://news.ycombinator.com" target="_blank" rel="noopener">Hacker News</a>
      · Traducción por <a class="text-stone-700 hover:underline" href="https://mymemory.translated.net" target="_blank" rel="noopener">MyMemory</a>
      · Contexto por <a class="text-stone-700 hover:underline" href="https://r.jina.ai" target="_blank" rel="noopener">Jina Reader</a>
    </footer>
  </main>

  <script>
    const headerEl = document.querySelector('header') as HTMLElement | null;
    const headerInner = headerEl?.querySelector(':scope > div') as HTMLElement | null;
    const headerTitle = headerEl?.querySelector('h1') as HTMLElement | null;
    const headerTitleWrap = headerEl?.querySelector('.mt-2.border-t') as HTMLElement | null;
    function updateHeader() {
      if (!headerInner || !headerTitle) return;
      const compact = window.scrollY > 60;
      headerInner.classList.toggle('py-3', !compact);
      headerInner.classList.toggle('py-1', compact);
      headerTitle.classList.toggle('text-4xl', !compact);
      headerTitle.classList.toggle('sm:text-5xl', !compact);
      headerTitle.classList.toggle('text-2xl', compact);
      headerTitle.classList.toggle('sm:text-3xl', compact);
      if (headerTitleWrap) {
        headerTitleWrap.classList.toggle('mt-2', !compact);
        headerTitleWrap.classList.toggle('mt-1', compact);
        headerTitleWrap.classList.toggle('pt-2', !compact);
        headerTitleWrap.classList.toggle('pt-1', compact);
      }
    }
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  </script>
</Layout>
